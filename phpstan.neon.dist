parameters:
    level: 5
    phpVersion:
        min: 70200
        max: 80400
    excludePaths:
        - */Tests/*
        - */vendor/*
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # False positive from third-party docblocks: TreeBuilder::getRootNode() is declared as NodeDefinition, while the
        # runtime object is ArrayNodeDefinition. Not reported by every Symfony version, hence reportUnmatched: false.
        -
            message: '#^Call to an undefined method Symfony\\Component\\Config\\Definition\\Builder\\NodeDefinition\:\:children\(\)\.$#'
            identifier: method.notFound
            reportUnmatched: false
            path: DependencyInjection/Configuration.php
        # False positive caused by the analysis environment: Symfony >= 6 declares native "mixed" parameters on
        # InputBag::get() and JsonResponse::__construct(), which PHPStan reads as a class named
        # Symfony\Component\HttpFoundation\mixed because phpVersion.min is 7.2. Not reported when analysing against
        # Symfony 5.x, hence reportUnmatched: false.
        -
            message: '#^Parameter \#(1 \$data of class Symfony\\Component\\HttpFoundation\\JsonResponse constructor|2 \$default of method Symfony\\Component\\HttpFoundation\\InputBag::get\(\)) expects Symfony\\Component\\HttpFoundation\\mixed\|null, .+ given\.$#'
            identifier: argument.type
            reportUnmatched: false
            path: Controller/File/ExterminateController.php
